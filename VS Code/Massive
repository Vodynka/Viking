#include <stdio.h>

// Структура корабля
struct Ship {
    int length;
    int row;
    int col;
    int isHorizontal; // В C нет типа bool, используем int (1 - горизонтально, 0 - вертикально)
};

// Функция для отрисовки одного игрового поля
void printBoard(char board[20][20], const char* title) {
    printf("\n=== %s ===\n", title);
    
    // Вывод шапки с номерами столбцов
    printf("     ");
    for (int j = 0; j < 20; j++) {
        int jn = j + 1;
        if (jn < 10) {
            printf("%d  ", jn);
        } else {
            printf("%d ", jn);
        }
    }
    printf("\n");

    // Вывод разделительной линии
    printf("    ");
    for (int j = 0; j < 60; j++) {
        printf("-");
    }
    printf("\n");

    // Вывод строк поля с номерами
    for (int i = 0; i < 20; i++) {
        int in = i + 1;
        if (in < 10) {
            printf(" %d |", in);
        } else {
            printf("%d |", in);
        }

        for (int j = 0; j < 20; j++) {
            printf("%c  ", board[i][j]);
        }
        printf("\n");
    }
}

int main() {
    // Два поля: 
    // playerBoard — поле противника, куда стреляете вы (будем отмечать попадания/промахи)
    // enemyBoard — ваше поле, куда стреляет противник (здесь стоят ваши корабли)
    char playerBoard[20][20];
    char enemyBoard[20][20];

    // Инициализация обоих полей пустыми точками
    for (int i = 0; i < 20; i++) {
        for (int j = 0; j < 20; j++) {
            playerBoard[i][j] = '.';
            enemyBoard[i][j] = '.';
        }
    }

    // Ваши корабли на поле противника (для демонстрации)
    struct Ship ships[] = {
        {4, 1, 1, 1},   // Четырёхпалубный
        {3, 3, 5, 0},   // Трёхпалубный
        {2, 7, 2, 1},   // Двухпалубный
        {1, 9, 9, 1}    // Однопалубный
    };
    int shipCount = 4;

    // Размещение кораблей на поле противника
    for (int s = 0; s < shipCount; s++) {
        for (int k = 0; k < ships[s].length; k++) {
            int r = ships[s].row;
            int c = ships[s].col;
            if (ships[s].isHorizontal) {
                if (c + k < 20 && r < 20) {
                    playerBoard[r][c + k] = '#'; // Показываем корабль (в реальной игре можно скрывать)
                }
            } else {
                if (r + k < 20 && c < 20) {
                    playerBoard[r + k][c] = '#';
                }
            }
        }
    }

    int rCoord, cCoord;

    // Игровой цикл (пример на 1 ход)
    printBoard(playerBoard, "Поле оппонента (куда стреляешь ты)");
    printBoard(enemyBoard, "Твоё поле (куда стреляет оппонент)");

    // 1) Ход игрока
    printf("\nТвой ход, солдат! Введи коордианты чтобы выпустить снаряд (stroka stolbec ot 1 do 20): ");
    if (scanf("%d %d", &rCoord, &cCoord) == 2) {
        // Переводим в индексы массива (от 0 до 19)
        int r = rCoord - 1;
        int c = cCoord - 1;

        if (r >= 0 && r < 20 && c >= 0 && c < 20) {
            if (playerBoard[r][c] == '#') {
                printf("Есть пробитие!\n");
                playerBoard[r][c] = 'X';
            } else if (playerBoard[r][c] == '.') {
                printf("Мимо!\n");
                playerBoard[r][c] = 'o';
            } else {
                printf("Молния 2 раза в одно и тоже место не бьёт!\n");
            }
        } else {
            printf("Куда по гражданке стреляешь!?\n");
        }
    }

    // 2) Ход противника
    printf("\nХод противника... Введи координаты, куда он будет стрелять (stroka stolbec): ");
    if (scanf("%d %d", &rCoord, &cCoord) == 2) {
        int r = rCoord - 1;
        int c = cCoord - 1;

        if (r >= 0 && r < 20 && c >= 0 && c < 20) {
            // Для примера отметим выстрел противника на вашем поле
            if (enemyBoard[r][c] == '.') {
                enemyBoard[r][c] = 'X'; // Пусть противник всегда попадает или отмечает выстрел
                printf("Чужеземец стрелял в [%d, %d] я дал отметку вообще-то!\n", rCoord, cCoord);
            }
        }
    }

    // Финальный вывод обновленных полей
 
    printBoard(playerBoard, "Поле оппонента (после твоего хода)");
    printBoard(enemyBoard, "Ваше поле (после хода чужеземца)");

    return 0;
}